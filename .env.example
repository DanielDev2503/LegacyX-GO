# LegacyX-GO Environment Variables Template
# Copy this file to .env and configure values for your environment.

# Server Port (Railway default: automatically injected via $PORT)
PORT=8080

# Environment Mode: 'production' | 'development' | 'test'
NODE_ENV=production

# Public WebSocket URL for clients connecting via internet
PUBLIC_SIGNALING_URL=wss://legacyx-signaling.up.railway.app

# Supabase Configuration (Accounts, Roles & Competitive Rankings)
SUPABASE_URL=https://jeopwutoxmaagxlebpsl.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YLPCQO9kz0l9oFkuEPIXow_uRebEaEf
SUPABASE_ANON_KEY=
# Optional backend-only service role key (never expose in client bundle)
SUPABASE_SERVICE_ROLE_KEY=

# Ranked Match Token HMAC Secret & Optional Superadmin Bootstrap Identifiers (comma-separated usernames/emails)
MATCH_TOKEN_SECRET=change_me_ranked_match_hmac_secret
SUPERADMIN_IDENTIFIERS=

# Optional Transactional Email Webhook / Resend API Key for 6-digit verification codes
RESEND_API_KEY=
VERIFICATION_FROM_EMAIL=noreply@legacyx-go.gg

# Coturn / STUN / TURN Relay Credentials (for restrictive NAT traversal)
TURN_URL=turn:turn.example.com:3478
TURN_USERNAME=legacyx_user
TURN_CREDENTIAL=super_secret_turn_password_change_me
